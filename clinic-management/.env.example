# Copy this file to ".env" (same folder) and fill in real values before deploying.
#   cp .env.example .env        (Linux/Mac)
#   copy .env.example .env      (Windows)
# Docker Compose automatically reads ".env". Never commit the real ".env".

# ---- Database ----
POSTGRES_USER=postgres
# Use a strong password in production (letters + numbers + symbols).
POSTGRES_PASSWORD=change_me_to_a_strong_password
POSTGRES_DB=clinic_app

# ---- API security ----
# JWT signing secret. MUST be at least 32 characters. Generate a random one, e.g.:
#   PowerShell:  -join ((48..122) | Get-Random -Count 48 | % {[char]$_})
#   Linux/Mac:   openssl rand -base64 48
JWT_KEY=replace_with_a_long_random_secret_at_least_32_characters

# ---- Local development ----
# Host port the web app is published on when running the plain compose file.
WEB_PORT=8080

# ---- Production HTTPS (used only with docker-compose.prod.yml + Caddy) ----
# The domain or free subdomain that points to your server's public IP.
# Examples: clinic.example.com  |  yourclinic.duckdns.org  |  203-0-113-5.sslip.io
DOMAIN=localhost
# Email for Let's Encrypt certificate notices (optional but recommended).
ACME_EMAIL=admin@example.com
